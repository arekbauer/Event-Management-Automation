# Calendar IDs are identifiers, not credentials. Keep environment-specific values out of code.
POKEMON_GO_CALENDAR_ID=example@group.calendar.google.com
VALORANT_CALENDAR_ID=example@group.calendar.google.com

# Optional locally. GitHub Actions should authenticate through Workload Identity Federation.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-service-account.json

# Optional failure notification destination.
DISCORD_WEBHOOK_URL=
